{
  "name": "centre-manager-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:app": "cross-env APP_SITE=app-main vite",
    "dev:kiosk": "cross-env APP_SITE=app-kiosk vite",
    "build:app": "npm run type-check && npm run build-only:app",
    "build:kiosk": "npm run type-check && npm run build-only:kiosk",
    "preview": "vite preview",
    "build-only:app": "cross-env APP_SITE=app-main vite build",
    "build-only:kiosk": "cross-env APP_SITE=app-kiosk vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.2",
    "@headlessui/vue": "^1.7.23",
    "@sentry/vue": "^7.100.1",
    "axios": "^1.13.5",
    "lodash": "^4.17.23",
    "moment": "^2.30.1",
    "pinia": "^2.1.7",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.3",
    "vue": "^3.4.14",
    "vue-drawing-canvas": "^1.0.14",
    "vue-router": "^4.2.5",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/node20": "^20.1.2",
    "@types/lodash": "^4.14.201",
    "@types/node": "^20.11.17",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "postcss": "^8.4.47",
    "prettier": "^3.0.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vue-tsc": "^3.2.2"
  }
}
