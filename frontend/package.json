{
  "name": "centre-manager-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev:app": "vite -c app.config.ts",
    "dev:kiosk": "vite -c app-kiosk.config.ts",
    "build:app": "npm run lint && npm run type-check && npm run build-only:app",
    "build:kiosk": "npm run lint && npm run type-check && npm run build-only:kiosk",
    "preview": "vite preview",
    "build-only:app": "vite build -c app.config.ts",
    "build-only:kiosk": "vite build -c app-kiosk.config.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.2",
    "@popperjs/core": "^2.11.8",
    "@sentry/vue": "^7.100.1",
    "axios": "^1.9.0",
    "bootstrap": "^5.3.2",
    "datatables.net-bs5": "^2.3.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "pinia": "^2.1.7",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.3",
    "vue": "^3.4.14",
    "vue-drawing-canvas": "^1.0.14",
    "vue-router": "^4.2.5",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node20": "^20.1.2",
    "@types/bootstrap": "^5.2.8",
    "@types/lodash": "^4.14.201",
    "@types/node": "^20.11.17",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "prettier": "^3.0.3",
    "sass": "^1.69.5",
    "typescript": "~5.2.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vue-tsc": "^1.8.27"
  }
}
