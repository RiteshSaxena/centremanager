{
  "kind": "collectionType",
  "collectionName": "children",
  "info": {
    "singularName": "child",
    "pluralName": "children",
    "displayName": "Child",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": false
    },
    "gender": {
      "type": "enumeration",
      "enum": [
        "Male",
        "Female",
        "Others"
      ]
    },
    "houseNumber": {
      "type": "string"
    },
    "streetName": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "subjects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::subject.subject"
    },
    "parents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::parent.parent",
      "inversedBy": "children"
    },
    "school": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::school.school"
    },
    "schoolYear": {
      "type": "string"
    }
