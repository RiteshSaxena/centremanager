      "target": "plugin::users-permissions.user"
    },
    "type": {
      "type": "enumeration",
      "enum": ["Staff", "Guest", "Student", "StudentWithParent", "Parent"]
    },
    "signInTime": {
      "type": "datetime"
    },
    "signOutTime": {
      "type": "datetime"
    },
